# 变量必须以 VITE_ 为前缀才能暴露给外部读取
NODE_ENV = 'production'
# 是否去除console 和 debugger
VITE_DELETE_CONSOLE = true
# 是否开启sourcemap
VITE_SHOW_SOURCEMAP = false

# production mode 后台请求地址
# 小程序端与 App 端必须是绝对地址（且小程序要把该域名加进「服务器域名」白名单）；
# H5 若与后端同源部署，可改成 '' 走同源，由 nginx 反代 /admin-api。
VITE_SERVER_BASEURL = 'https://demo.enlev.cn/admin-api'

# 文件上传地址由 src/api/infra/file/index.ts 按 `${getEnvBaseUrl()}/infra/file/upload` 拼出，
# 不需要、也没有任何代码读取 VITE_UPLOAD_BASEURL，因此此处不再配置该变量。

# 静态资源地址（staticUrl() 的前缀）。留空表示走应用自身的 /static/，不要指向上游演示域名。
VITE_STATIC_BASEURL = ''

# 「联系客服」页三项配置继承自 .env（默认全空 → 该页显示「暂未配置客服信息」占位）。
# 正式上线前按实际客服渠道在此覆盖，例如：
# VITE_APP_SERVICE_QRCODE = 'https://demo.enlev.cn/static/service-qrcode.png'
# VITE_APP_SERVICE_PHONE = '400-000-0000'
# VITE_APP_SERVICE_TIME = '工作日 9:00 - 18:00'
